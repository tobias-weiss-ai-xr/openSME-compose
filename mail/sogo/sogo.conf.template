// SOGo Groupware — production config template for up to 500 users
// Connects to Stalwart via IMAP/SMTP, PostgreSQL via PgBouncer.
//
// This file is processed by envsubst at container start.
// Variables are substituted from Docker environment.
// See mail/sogo/sogo-entrypoint.sh

{
  // Server
  WOPort = 20000;
  WOHTTPEnabled = YES;
  WOLogFile = /var/log/sogo/sogo.log;
  SOPidFile = /var/run/sogo/sogo.pid;
  WOWorkersCount = 8;

  // Database via PgBouncer (transaction pooling)
  OCSFolderInfoURL = "postgresql://opensme:${SOGO_DB_PASSWORD}@pgbouncer:5432/sogo/sogo_folder_info";
  OCSSessionsFolderURL = "postgresql://opensme:${SOGO_DB_PASSWORD}@pgbouncer:5432/sogo/sogo_sessions_folder";
  OCSStoreURL = "postgresql://opensme:${SOGO_DB_PASSWORD}@pgbouncer:5432/sogo/sogo_store";
  OCSACLsURL = "postgresql://opensme:${SOGO_DB_PASSWORD}@pgbouncer:5432/sogo_acl";
  OCSLanguagesURL = "postgresql://opensme:${SOGO_DB_PASSWORD}@pgbouncer:5432/sogo/sogo_languages";

  // Authentication via LDAP
  SOGoUserSources = (
    {
      type = ldap;
      CNFieldName = cn;
      UIDFieldName = uid;
      IDFieldName = uid;
      bindDN = "cn=admin,${LDAP_ROOT_DN}";
      bindFields = (uid, mail);
      bindPassword = "${LDAP_ADMIN_PASSWORD}";
      baseDN = "${LDAP_ROOT_DN}";
      canAuthenticate = YES;
      displayName = "openSME Users";
      hostname = "ldap";
      id = "opensme-ldap";
      port = 389;
      cacheTimeout = 300;
    }
  );

  // Mail (via Stalwart)
  SOGoDraftsFolderName = Drafts;
  SOGoSentFolderName = Sent;
  SOGoTrashFolderName = Trash;
  SOGoJunkFolderName = Junk;
  SOGoMailDomain = "${OPENSME_DOMAIN}";
  SOGoIMAPServer = "stalwart";
  SOGoSMTPServer = "stalwart";
  SOGoSMTPAuthenticationType = PLAIN;
  SOGoForceExternalLoginWithEmail = NO;
  SOGoMailSpoolPath = "/tmp";

  // Performance
  SOGoMaximumSyncWindowSize = 100;
  SOGoConnectionsPoolSize = 20;
  SOGoPendingDropBoxEnabled = YES;
  SOGoPendingDropBoxSizeLimit = 50;
  SOGoPendingMailDropBoxSizeLimit = 50;

  // General
  SOGoTimeZone = "${TZ:-Europe/Berlin}";
  SOGoDefaultUser = "user01";
  SOGoLanguage = German;
  SOGoAppointmentSendEMailNotifications = YES;

  // Calendar & Contacts
  SOGoEnablePublicAccess = NO;
  SOGoFreeBusyDefaultInterval = 600;
  SOGoFreeBusyPublishInterval = 60;
}
