# Stalwart Mail Server — production config for up to 500 users
# Full config is persisted to stalwart-etc volume on first start.
# NOTE: TLS certificate paths are for Traefik-provided certs or must be
#       provisioned separately. Set acme.enable=true in production for
#       auto-provisioned certs, or mount certs into the stalwart-etc volume.

[session]
threads = 8

[report]
type = "log"
log = "info"

[queue]
outbound = true
inbound = true
max-retries = 5
retry-after = ["5m", "15m", "1h", "4h", "12h"]

[storage]
data = "/var/lib/stalwart/data"
blob = "disk"
blob.disk = "/var/lib/stalwart/blobs"
lookup = "internal"
fts = "internal"
fts.index_dir = "/var/lib/stalwart/fts"

[tls]
# Certs are auto-provisioned by Stalwart's built-in ACME or mounted manually.
# For first-time setup, comment out certificate/private-key to skip TLS.
# enable = true
# certificate = "/etc/stalwart/certs/cert.pem"
# private-key = "/etc/stalwart/certs/key.pem"

[lmdb]
path = "/var/lib/stalwart/data"
size = 4294967296

[smtp]
# Rendered from MAIL_DOMAIN env var at startup
hostname = "${MAIL_DOMAIN:-mail.opensme.org}"
port = 25
tls-port = 465
max-recipients = 100
max-message-size = 26214400
max-concurrent-connections = 50
rate-limit = "100/1m"

[imap]
enable = true
port = 143
tls-port = 993
max-concurrent-connections = 200
rate-limit = "500/1m"

[jmap]
enable = true
port = 8080
max-concurrent-requests = 100
rate-limit = "200/1m"

[acme]
# Enable in production for auto-provisioned TLS certs
enable = false

[authentication]
fallback-admin = "admin"
rate-limit = "30/1m"
