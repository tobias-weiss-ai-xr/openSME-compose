# ──────────────────────────────────────────────
# openSME Compose — Configuration
# ──────────────────────────────────────────────
# Copy to .env and adjust for your deployment.
# See README.md for hardware recommendations per tier.

# ── Domains ──
OPENSME_DOMAIN=opensme.org
OPENCLOUD_DOMAIN=cloud.opensme.org
MAIL_DOMAIN=mail.opensme.org
SOGO_DOMAIN=webmail.opensme.org
COLLABORA_DOMAIN=collabora.opensme.org
ZITADEL_DOMAIN=auth.opensme.org
# Zitadel image (v3 line — current images need an external init+setup)
ZITADEL_IMAGE=ghcr.io/zitadel/zitadel:v4.19.4
PORTAL_DOMAIN=portal.opensme.org

# ── Database ──
POSTGRES_PASSWORD=CHANGEME_postgres
REDIS_PASSWORD=CHANGEME_redis
# ZITADEL_DB_NAME=zitadel (auto-created by postgres-init)
SOGO_DB_PASSWORD=CHANGEME_sogo

# ── LDAP ──
# DN derived from OPENSME_DOMAIN, e.g. opensme.org → dc=opensme,dc=org
# Override only if your domain maps to a different DN structure.
LDAP_ROOT_DN=dc=opensme,dc=org
LDAP_ADMIN_PASSWORD=CHANGEME_ldap
LDAP_USER_PASSWORD=CHANGEME_user

# ── Zitadel (IAM/SSO) ──
# Zitadel first admin (created on first start)
ZITADEL_ADMIN_EMAIL=admin@opensme.org
ZITADEL_ADMIN_PASSWORD=CHANGEME_zitadel

# ── OpenCloud ──
OC_ADMIN_USERNAME=admin
OC_ADMIN_PASSWORD=CHANGEME_oc_admin
OC_OIDC_SECRET=CHANGEME_oidc_secret
# OC_JWT_SECRET, OC_TRANSFER_SECRET, OC_URL_SIGNING_SECRET:
# Auto-generated by opencloud init on first run (stored in opencloud-config volume).
# No manual configuration needed.
OC_S3_ENDPOINT=http://minio:9000
OC_S3_REGION=us-east-1
OC_S3_BUCKET=opencloud
OC_S3_ACCESS_KEY=minio
OC_S3_SECRET_KEY=CHANGEME_minio
OC_INSECURE=true
# ^ true is correct for Docker Compose — inter-service traffic stays on the
#   internal network (no TLS). Security boundary is Traefik.
NOTIFICATIONS_SMTP_SENDER=noreply@opensme.org
# ^ Sender address for OpenCloud notification emails

# ── Collabora ──
COLLABORA_USERNAME=admin
COLLABORA_PASSWORD=CHANGEME_collabora

# ── Mail (Stalwart) ──
STALWART_ADMIN_PASSWORD=CHANGEME_stalwart_admin
# ^ Stalwart admin password (required for initial setup)

# ── Traefik ──
TRAEFIK_ACME_EMAIL=admin@opensme.org
# Generate with: htpasswd -nb admin your-password
TRAEFIK_USERS=admin:$apr1$CHANGEME

# ── Portal ──
# Set to empty to hide from portal landing page
MAIL_URL=
COLLABORA_URL=

# ── Logging ──
LOG_LEVEL=info
LOG_PRETTY=true
TZ=Europe/Berlin

# ── Coexist Profile (existing Traefik) ──
# Set when using profiles/demo.coexist.yml to piggyback on a host Traefik.
EXISTING_NETWORK=traefik-web
EXISTING_TRAEFIK_HTTPS=websecure

# ── Feature Flags (set COMPOSE_FILE in env or cli) ──
COMPOSE_FILE=docker-compose.yml

# ── Optional Services (per-service DB passwords) ──
# Only needed if the corresponding service profile is enabled.
CASDOOR_DB_PASSWORD=CHANGEME_casdoor
SYNAPSE_DB_PASSWORD=CHANGEME_synapse
SYNAPSE_OIDC_CLIENT_SECRET=CHANGEME_synapse_oidc
PAPERLESS_DB_PASSWORD=CHANGEME_paperless
PAPERLESS_SECRET_KEY=CHANGEME_generate_64_chars
INVOICENINJA_DB_PASSWORD=CHANGEME_invoiceninja
NOTES_DB_PASSWORD=CHANGEME_notes
NOTES_DJANGO_SECRET_KEY=CHANGEME_notes_django
NOTES_OIDC_CLIENT_SECRET=CHANGEME_notes_oidc
NOTES_COLLABORATION_SECRET=CHANGEME_notes_collab

# ── Nosdesk ticketing (--profile ticketing) ──
NOSDESK_DB_PASSWORD=CHANGEME_nosdesk_db
# openssl rand -base64 32
NOSDESK_JWT_SECRET=CHANGEME_nosdesk_jwt
# openssl rand -hex 32
NOSDESK_MFA_KEK=CHANGEME_nosdesk_mfa
NOSDESK_OIDC_ISSUER=
NOSDESK_OIDC_CLIENT_ID=
NOSDESK_OIDC_CLIENT_SECRET=

# ── Portal extras ──
# JSON array of {"level":"info|warn","text":"…"} banners shown on the portal
PORTAL_ANNOUNCEMENTS=
# OpenAI-compatible chat endpoint, e.g. http://vllm:8000 (empty hides the AI card)
# With `--profile ai` set it to http://ai:8080 (built-in llama.cpp server)
AI_API_URL=
AI_MODEL=CHANGEME_model_name
AI_API_KEY=
# Portal cards for optional components (empty = card hidden)
TICKETING_URL=
CMS_URL=
SHOP_URL=

# ── crap-cms website (--profile cms) ──
# upstream publishes :latest only; pin here once semver tags exist, e.g.
# CMS_IMAGE=ghcr.io/dkluhzeb/crap-cms:0.1.0
CMS_IMAGE=

# ── RaisFast store (--profile store) ──
# bootstrap admin password (otherwise printed once to logs on first boot)
STORE_ADMIN_PASSWORD=CHANGEME_store_admin
# build arch for the local image: x86_64 (amd64) or aarch64 (arm64)
STORE_ARCH=x86_64

# ── llama.cpp AI server (--profile ai) ──
# OpenAI-compatible inference at http://ai:8080 (point AI_API_URL there)
# build-numbered tag — llama.cpp publishes no semver docker tags
AI_IMAGE=
# HuggingFace model repo:quant, auto-downloaded to the ai-models volume on
# first boot (~1 GB for the default). Pick bigger models for more capability.
AI_HF_MODEL=
CRYPTPAD_ADMIN_EMAIL=admin@opensme.org
CPAD_SESSION_SECRET=CHANGEME_cpad

# ── Monitoring (optional overlays) ──
# Include via COMPOSE_FILE=docker-compose.yml:monitoring/dev-agent.yml
# Images (replace with your registry/tag when ready):
#   Build locally with Nix: cd monitoring/nix && nix build .#dev-agent .#predictive-agent .#taskfleet
#   Then: docker load < result-dev-agent  (etc.)
#   Nix-built images use the *-nix tag (e.g., dev-agent:latest-nix)
DEV_AGENT_IMAGE=ghcr.io/tobias-weiss-ai-xr/dev-agent:latest
PREDICTIVE_AGENT_IMAGE=ghcr.io/tobias-weiss-ai-xr/predictive-agent:latest
TASKFLEET_IMAGE=ghcr.io/tobias-weiss-ai-xr/taskfleet:latest
# dev-maintenance-bot (Go, one-shot, runbook KB + consent-gated healing):
# DEV_MAINTENANCE_BOT_IMAGE=opensme-dev-maintenance-bot:latest   # local build via `make agent-build`
# DEV_AGENT_INTERVAL=60s          # reconcile interval
# DEV_AGENT_WATCH=opensme        # comma-separated compose projects to watch
# DEV_AGENT_ALLOW_HEAL=false      # MUST stay false unless you accept real restarts
# DEV_AGENT_HOSTNAMES=            # extra hostnames the anonymizer scrubs (comma-separated)
# DEV_AGENT_LLM_BACKEND=none      # none|ollama|saia|tud|openai — none = never dial out
# DEV_AGENT_LLM_URL=              # override backend URL
# DEV_AGENT_LLM_MODEL=            # override backend model
# DEV_AGENT_LLM_KEY=              # override backend API key (never logged)
# DEV_MAINTENANCE_BOT_LLM_BACKEND=none  # bot-specific LLM opt-in (independent of DEV_AGENT_LLM_BACKEND)
# LLM backend (ollama | saia | tud | openai)
# For local Ollama, include monitoring/ollama.yml and keep OLLAMA_URL=http://ollama:11434
# For external LLM, set OLLAMA_URL to the endpoint and provide API keys as needed.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3-30b-a3b:latest
OLLAMA_TIMEOUT=180
# External LLM API keys (optional — only needed if LLM_BACKEND != ollama)
# DEV_AGENT_LLM_BACKEND=ollama
# PREDICTIVE_AGENT_LLM_BACKEND=ollama
# SAIA_API_URL=https://chat-ai.academiccloud.de/v1
# SAIA_API_KEY=
# TUD_API_URL=https://llm-service.ai.tu-darmstadt.de/v1
# TUD_API_KEY=
# OPENAI_API_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# Watch namespaces (comma-separated Docker compose project names)
# DEV_AGENT_WATCH_NAMESPACES=opensme,default
# PREDICTIVE_AGENT_WATCH_NAMESPACES=opensme,default
# Reconcile / analysis tuning
# DEV_AGENT_RECONCILE_INTERVAL=60
# PREDICTIVE_AGENT_RECONCILE_INTERVAL=60
# PREDICTION_ENABLED=true
# PREDICTION_RISK_THRESHOLD=0.5
# taskfleet
# TF_REPO_DIR=/path/to/your/repo
# TF_MAX_PARALLEL=2

# ── Image digest pinning ────────────────────────────────
# Pin stable images to a specific digest for reproducible deploys.
# Each <IMG>_IMAGE override in the compose files honours the digest form:
#   TRAEFIK_IMAGE_DIGEST=traefik:v3.3@sha256:<hex>
#   POSTGRES_IMAGE_DIGEST=postgres:17-alpine@sha256:<hex>
#   REDIS_IMAGE_DIGEST=redis:7-alpine@sha256:<hex>
#   MEMCACHED_IMAGE_DIGEST=memcached:1.6-alpine@sha256:<hex>
#   STALWART_IMAGE_DIGEST=stalwartlabs/stalwart:v0.15@sha256:<hex>
#   SOGO_IMAGE_DIGEST=salvoxia/sogo:latest@sha256:<hex>
# When set, keep the corresponding service's <IMG>_IMAGE pointing at the
# same tag@digest (asserted by tests/00-static/check_perf.py).

# ── Optional container image overrides ────────────
STALWART_IMAGE=stalwartlabs/stalwart:v0.15
COLLABORA_IMAGE=collabora/code:latest
PGBOUNCER_IMAGE=bitnamilegacy/pgbouncer:latest
TIKA_IMAGE=apache/tika:latest
