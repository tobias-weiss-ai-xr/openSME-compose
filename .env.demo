# ═══════════════════════════════════════════════════════════════
# openSME — Live Demo Environment Template
# ═══════════════════════════════════════════════════════════════
#
# For reference only — demo-live.sh auto-generates .env with
# random passwords. You don't need to edit this file.
#
# ═══════════════════════════════════════════════════════════════

# ── Domains ────────────────────────────────────────
OPENSME_DOMAIN=home.opensme.org
PORTAL_DOMAIN=home.opensme.org
ZITADEL_DOMAIN=auth.home.opensme.org
IDP_URL=https://auth.home.opensme.org
OPENCLOUD_DOMAIN=cloud.home.opensme.org

# ── Portal (empty = hidden from landing page) ────
MAIL_URL=
COLLABORA_URL=

# ── Database ──────────────────────────────────────
POSTGRES_PASSWORD=auto-generated
SOGO_DB_PASSWORD=auto-generated

# ── LDAP (for SOGo groupware — not used in demo) ──
LDAP_ROOT_DN=dc=opensme,dc=org
LDAP_ADMIN_PASSWORD=auto-generated
LDAP_USER_PASSWORD=auto-generated

# ── Zitadel (IAM/SSO) ──
ZITADEL_ADMIN=admin
ZITADEL_ADMIN_PASSWORD=auto-generated

# ── OpenCloud ──
OC_ADMIN_USERNAME=admin
OC_ADMIN_PASSWORD=auto-generated
OC_OIDC_SECRET=auto-generated

# ── Traefik ──
TRAEFIK_ACME_EMAIL=auto-generated

# ── Logging ──
LOG_LEVEL=info
LOG_PRETTY=true
