# ═══════════════════════════════════════════════════════════════
# openSME — Live Demo Environment Template
# ═══════════════════════════════════════════════════════════════
#
# Usage:
#   cp .env.demo .env
#   # Edit the 2 required values below (ACME_EMAIL, ADMIN_PASSWORD)
#   ./scripts/demo-live.sh
#
# The script auto-generates random passwords for all other secrets.
# ═══════════════════════════════════════════════════════════════

# ── Domains ────────────────────────────────────────
OPENSME_DOMAIN=home.opensme.org
PORTAL_DOMAIN=home.opensme.org
KEYCLOAK_DOMAIN=auth.home.opensme.org
OPENCLOUD_DOMAIN=cloud.home.opensme.org

# ── REQUIRED: fill these before deploying ────────
TRAEFIK_ACME_EMAIL=YOUR_EMAIL@example.com
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# ── Database ──────────────────────────────────────
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
SOGO_DB_PASSWORD=

# ── OpenCloud ─────────────────────────────────────
OC_ADMIN_USERNAME=admin
OC_ADMIN_PASSWORD=
OC_OIDC_SECRET=

# ── Keycloak ─────────────────────────────────────
KEYCLOAK_ADMIN=admin

# ── Traefik ──────────────────────────────────────
TRAEFIK_ACME_ENABLED=false

# ── Logging ──────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=true
